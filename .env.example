# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# .env.local .gitignore'da; production değerleri Vercel > Settings > Environment Variables'a girilir.

# n8n Webhook node'larının adresleri (local n8n + ngrok static domain).
# Hafta 1 testi için buraya geçici olarak bir webhook.site adresi de yazabilirsiniz.
N8N_ORDER_WEBHOOK_URL=
N8N_STOCK_WEBHOOK_URL=

# n8n tarafında X-Atolyekart-Secret header'ı ile kontrol edilen paylaşılan secret.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# IP başına dakikada izin verilen form isteği (varsayılan 10).
RATE_LIMIT_PER_MINUTE=10
