# n8n/.env olarak kopyalayın (git'e girmez). docker compose bu dosyayı otomatik okur.

# Vercel API ile n8n arasındaki paylaşılan secret. Kök dizindeki .env.local ve Vercel env'deki
# WEBHOOK_SECRET ile AYNI olmalı. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# n8n'in products.json'u okuyacağı site adresi (sonunda / olmadan).
# Deploy ettiysen Vercel adresi; etmediysen kökte `npm run dev` açıkken http://host.docker.internal:3000
ATOLYEKART_SITE_URL=http://host.docker.internal:3000

# Google Sheet ID'si: https://docs.google.com/spreadsheets/d/<BU_KISIM>/edit
ATOLYEKART_SHEET_ID=

# ngrok (profile: tunnel). Ücretsiz hesapta 1 sabit domain verilir: dashboard.ngrok.com > Domains
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Yukarıdaki domain'in https'li hali; n8n webhook URL'lerini buna göre gösterir.
N8N_PUBLIC_URL=
