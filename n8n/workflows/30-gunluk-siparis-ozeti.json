    {
      "id": "c7e16a23-5ea2-406a-aff0-f8e0b11295a0",
      "name": "Bugünü ürüne göre grupla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// Bugünün (Europe/Istanbul) siparişlerini ürün bazında gruplar: sipariş sayısı + toplam adet.\nconst today = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Istanbul' }); // YYYY-MM-DD\nconst groups = {};\n\nfor (const { json: row } of $input.all()) {\n  if (!row.timestamp) continue;\n  const day = new Date(row.timestamp).toLocaleDateString('sv-SE', { timeZone: 'Europe/Istanbul' });\n  if (day !== today) continue;\n  const g = (groups[row.productId] ??= { tarih: today, productId: row.productId, productName: row.productName, siparisSayisi: 0, toplamAdet: 0 });\n  g.siparisSayisi += 1;\n  g.toplamAdet += Number(row.quantity) || 0;\n}\n\nreturn Object.values(groups)\n  .sort((a, b) => b.toplamAdet - a.toplamAdet)\n  .map((g) => ({ json: g }));"
      }
    },
