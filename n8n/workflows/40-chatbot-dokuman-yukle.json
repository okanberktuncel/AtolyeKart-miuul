    {
      "id": "80f15f6a-d4a7-4188-a93f-b152eb286601",
      "name": "Metadata ekle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Dosya adından metadata üretir: seramik-bakim-rehberi-v1.pdf → category=seramik, version=1\nconst fileName = $input.item.binary.data.fileName;\nconst category = fileName.startsWith('seramik') ? 'seramik' : fileName.includes('mum') ? 'mum' : 'genel';\nconst version = (fileName.match(/-v(\\d+)\\.pdf$/) || [])[1] || '1';\nreturn { json: { doc: fileName, category, version }, binary: $input.item.binary };"
      }
    },
    {
      "id": "e6889727-6163-4be7-a030-2475f9cf9ef8",
      "name": "Qdrant'a yaz",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [
        900,
        0
      ],
      "parameters": {
        "mode": "insert",
        "qdrantCollection": {
          "__rl": true,
          "mode": "id",
          "value": "atolyekart_docs"
        },
        "options": {}
      },
