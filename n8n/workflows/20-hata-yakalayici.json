      "parameters": {
        "jsCode": "// Error Trigger'ın verisini tek satırlık bir log kaydına çevirir.\nconst e = $input.first().json;\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    workflow: e.workflow?.name ?? '',\n    node: e.execution?.lastNodeExecuted ?? '',\n    message: e.execution?.error?.message ?? e.trigger?.error?.message ?? 'bilinmeyen hata',\n    executionId: e.execution?.id ?? '',\n    executionUrl: e.execution?.url ?? '',\n  },\n}];"
      }
    },
