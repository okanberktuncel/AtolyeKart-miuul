    {
      "id": "ab1d554a-e318-4cf7-a718-e7cbfccebcbd",
      "name": "Kuralları kontrol et",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// Sipariş Ver ve Stok Bildirimi İste akışlarının ortak doğrulaması.\n// Vercel API zaten doğruluyor; bu katman webhook'a doğrudan gelen istekler için ikinci savunma hattı.\nconst input = $('Alt akış girişi').first().json;\nconst products = $input.first().json.products;\nconst errors = [];\n\nconst emailOk = typeof input.email === 'string' && /^[^\\s@<>()]+@[^\\s@<>()]+\\.[a-z]{2,}$/i.test(input.email);\nif (!emailOk) errors.push('geçersiz e-posta');\n\nif (!['order.create', 'stock.notify'].includes(input.event)) errors.push(`bilinmeyen event: ${input.event}`);\n\nconst product = products.find((p) => p.id === input.productId);\nif (!product) errors.push(`bilinmeyen ürün ID: ${input.productId}`);\n\nif (input.event === 'order.create') {\n  const q = Number(input.quantity);\n  if (!Number.isInteger(q) || q < 1 || q > 20) errors.push('adet 1-20 arasında olmalı');\n  if (product && !product.inStock) errors.push('tükenmiş ürüne sipariş verilemez');\n}\n\nreturn [{ json: { ...input, productCategory: product ? product.category : null, valid: errors.length === 0, errors } }];"
      }
    },
