      "parameters": {
        "jsCode": "// Web, mobil ve n8n aynı products.json'u kullanır; ajan için gereksiz alanları atıyoruz.\nconst catalog = $input.first().json.products.map((p) => ({\n  id: p.id,\n  ad: p.title,\n  kategori: p.category,\n  fiyat: p.price,\n  birim: p.unit,\n  inStock: p.inStock,\n}));\nreturn [{ json: { catalog } }];"
      }
