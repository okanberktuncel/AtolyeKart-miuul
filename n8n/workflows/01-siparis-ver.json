    {
      "id": "5c8d254e-4389-4d88-a465-95eb543cbd32",
      "name": "Mail taslağı",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1660,
        -160
      ],
      "parameters": {
        "jsCode": "const order = $('Ortak doğrulama').first().json;\nconst mail = $input.first().json.output;\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    email: order.email,\n    name: order.name,\n    productName: order.productName,\n    subject: mail.subject,\n    body: mail.body,\n    estimatedPrepDays: mail.estimatedPrepDays,\n  },\n}];"
      }
    },
